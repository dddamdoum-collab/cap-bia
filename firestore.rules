rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les élèves peuvent seulement ENVOYER un signalement ; seul le propriétaire du projet les lit (console Firebase).
    // Chaque élève ne peut lire / écrire / supprimer QUE son propre document (prénom, 3 lettres, progression).
    match /users/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['prenom','nom3','progress','updated'])
                    && request.resource.data.prenom is string && request.resource.data.prenom.size() <= 30
                    && request.resource.data.nom3 is string && request.resource.data.nom3.size() <= 3
                    && request.resource.data.progress is string && request.resource.data.progress.size() < 700000;
      allow list: if false;
    }
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['q','src','detail','name','at','text'])
                    && request.resource.data.q is string && request.resource.data.q.size() < 20
                    && request.resource.data.detail is string && request.resource.data.detail.size() <= 600
                    && request.resource.data.text is string && request.resource.data.text.size() <= 2000
                    && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow read, update, delete: if false;
    }
  }
}
