rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('role','') == 'admin';
    }

    // Enseignants. Le premier administrateur (role = admin) est créé à la main dans la console Firebase.
    // Ensuite l'administrateur accepte ou retire les enseignants depuis le site.
    match /teachers/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['role','prenom','nom3'])
        && request.resource.data.role in ['teacher','admin']
        && request.resource.data.get('prenom','').size() <= 30
        && request.resource.data.get('nom3','').size() <= 3;
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Demandes de profil enseignant : chacun peut déposer / retirer la sienne, l'administrateur les lit.
    match /teacherRequests/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['prenom','nom3','at'])
        && request.resource.data.prenom is string && request.resource.data.prenom.size() <= 30
        && request.resource.data.nom3 is string && request.resource.data.nom3.size() <= 3;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Classes : un enseignant crée et gère les siennes. N'importe quel élève connecté peut lire une classe dont il connaît le code.
    match /classes/{code} {
      allow get: if request.auth != null;
      allow list: if isTeacher() && resource.data.owner == request.auth.uid;
      allow create: if isTeacher()
                    && request.resource.data.keys().hasOnly(['owner','name','created'])
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update, delete: if isTeacher() && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == resource.data.owner;
    }

    // Comptes élèves : prénom, 3 lettres, progression, classe.
    match /users/{uid} {
      function shapeOk(d) {
        return d.keys().hasOnly(['prenom','nom3','progress','updated','cls','tch','wipe'])
          && d.prenom is string && d.prenom.size() <= 30
          && d.nom3 is string && d.nom3.size() <= 3
          && d.progress is string && d.progress.size() < 700000;
      }
      // Une classe n'est acceptée que si son code existe et que « tch » est bien son enseignant.
      function classOk(d) {
        return (d.get('cls','') == '' && d.get('tch','') == '')
          || (d.get('cls','') is string && d.get('cls','').size() <= 12 && d.get('cls','') != ''
              && get(/databases/$(database)/documents/classes/$(d.get('cls',''))).data.owner == d.get('tch',''));
      }
      // Une fois rattaché à une classe, l'élève ne peut plus la quitter ni en changer : seul l'enseignant le peut.
      function keepClass() {
        return resource.data.get('cls','') == ''
          || (request.resource.data.get('cls','') == resource.data.get('cls','')
              && request.resource.data.get('tch','') == resource.data.get('tch',''));
      }
      allow get: if request.auth != null
                 && (request.auth.uid == uid || (isTeacher() && resource.data.get('tch','') == request.auth.uid));
      allow list: if isTeacher() && resource.data.get('tch','') == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && shapeOk(request.resource.data) && classOk(request.resource.data);
      allow update: if request.auth != null
                    && ((request.auth.uid == uid && shapeOk(request.resource.data) && classOk(request.resource.data) && keepClass())
                     || (isTeacher() && resource.data.get('tch','') == request.auth.uid
                         && shapeOk(request.resource.data)
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prenom','nom3','cls','tch','progress','wipe'])));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Signalements d'erreur : tout le monde peut ENVOYER, seul l'administrateur les lit et les supprime (depuis le site ou la console Firebase).
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['q','src','detail','name','at','text'])
                    && request.resource.data.q is string && request.resource.data.q.size() < 20
                    && request.resource.data.detail is string && request.resource.data.detail.size() <= 600
                    && request.resource.data.text is string && request.resource.data.text.size() <= 2000
                    && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
